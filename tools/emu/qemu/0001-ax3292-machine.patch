diff -Naur a/hw/or1k/ax3292.c b/hw/or1k/ax3292.c
--- a/hw/or1k/ax3292.c	1970-01-01 01:00:00.000000000 +0100
+++ b/hw/or1k/ax3292.c	2026-10-14 16:37:37.362316586 +0200
@@ -0,0 +1,258 @@
+/*
+ * AX3292 (KC02-family camera) machine.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Bare-metal machine for the dumped firmware.  It provides flat RAM and an
+ * SPR bus.  Everything on this chip is reached through special-purpose
+ * registers rather than memory, so the "bus" is the SPR hook in
+ * target/or1k/sys_helper.c.
+ *
+ * This first cut implements enough of the SPR bus to let the application run
+ * while logging every access, which is how the device model gets built:
+ *
+ *   - the architectural registers are remapped from the chip's numbering to
+ *     QEMU's (the chip does not use the OpenRISC spec numbers: SR is 0x18,
+ *     NPC 0x14, PPC 0x1C, EPCR 0x20, ESR 0x40, EVBA 0x50);
+ *   - SFR-group peripherals (>= 0x8000) read as zero and drop writes;
+ *   - every access is logged with its PC while the trace limit lasts.
+ *
+ * Reference: docs/EMULATOR_PLAN.md, docs/BOOT_MAP.md and the vendor SDK.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qemu/units.h"
+#include "qapi/error.h"
+#include "hw/core/boards.h"
+#include "hw/core/cpu.h"
+#include "hw/core/loader.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "system/reset.h"
+#include "target/or1k/cpu.h"
+
+#define TYPE_AX3292_MACHINE MACHINE_TYPE_NAME("ax3292")
+OBJECT_DECLARE_SIMPLE_TYPE(Ax3292State, AX3292_MACHINE)
+
+/* Application image: flash file offset 0x2600 loads at SDRAM 0x02000000.
+ * The boot code (file 0x520) sets SP to 0x027FFFFC and calls 0x0200046C. */
+#define AX3292_ENTRY        0x0200046C
+#define AX3292_STACK_TOP    0x027FFFFC
+#define AX3292_SDRAM_BASE   0x02000000
+#define AX3292_RAM_SIZE     (64 * MiB)
+
+struct Ax3292State {
+    MachineState parent;
+
+    MemoryRegion ram;
+
+    uint32_t entry;
+    bool trace;
+    unsigned long trace_limit;
+    unsigned long trace_count;
+};
+
+/* --- SPR bus ------------------------------------------------------------- */
+
+/*
+ * Architectural registers, in the chip's numbering.  See tools/emu/sfr_map.py:
+ * the compiler emits the __sfr byte address verbatim as the SPR number, and
+ * for group 0 that is not the OpenRISC spec numbering.
+ */
+enum {
+    AX3292_SPR_VR   = 0x00,
+    AX3292_SPR_NPC  = 0x14,
+    AX3292_SPR_SR   = 0x18,
+    AX3292_SPR_PPC  = 0x1C,
+    AX3292_SPR_EPCR = 0x20,
+    AX3292_SPR_EEAR = 0x30,   /* unconfirmed: or1k spec value, header disagrees */
+    AX3292_SPR_ESR  = 0x40,
+    AX3292_SPR_EVBA = 0x50,
+};
+
+static bool ax3292_spr_access(struct CPUArchState *env, void *opaque,
+                              bool is_write, uint32_t spr, uint32_t *value)
+{
+    Ax3292State *s = opaque;
+    uint32_t v = *value;
+
+    if (s->trace && s->trace_count < s->trace_limit) {
+        s->trace_count++;
+        fprintf(stderr, "spr %s %04x %08x pc=%08x\n",
+                is_write ? "W" : "R", spr, v, (uint32_t)env->pc);
+    }
+
+    switch (spr) {
+    case AX3292_SPR_VR:
+        if (!is_write) {
+            *value = 0x65803200;    /* observed on hardware */
+        }
+        return true;
+
+    case AX3292_SPR_NPC:            /* reading NPC gives the current PC */
+        if (!is_write) {
+            *value = (uint32_t)env->pc;
+        }
+        return true;
+
+    case AX3292_SPR_SR:
+        if (is_write) {
+            cpu_set_sr(env, v);
+        } else {
+            *value = cpu_get_sr(env);
+        }
+        return true;
+
+    case AX3292_SPR_PPC:
+        if (is_write) {
+            env->ppc = v;
+        } else {
+            *value = env->ppc;
+        }
+        return true;
+
+    case AX3292_SPR_EPCR:
+        if (is_write) {
+            env->epcr = v;
+        } else {
+            *value = env->epcr;
+        }
+        return true;
+
+    case AX3292_SPR_EEAR:
+        if (is_write) {
+            env->eear = v;
+        } else {
+            *value = env->eear;
+        }
+        return true;
+
+    case AX3292_SPR_ESR:
+        if (is_write) {
+            env->esr = v;
+        } else {
+            *value = env->esr;
+        }
+        return true;
+
+    case AX3292_SPR_EVBA:
+        if (is_write) {
+            env->evbar = v;
+        } else {
+            *value = env->evbar;
+        }
+        return true;
+
+    default:
+        break;
+    }
+
+    if (spr >= 0x8000) {
+        /* SFR-group peripheral.  No device model yet: reads as zero. */
+        if (!is_write) {
+            *value = 0;
+        }
+        return true;
+    }
+
+    /* Let the built-in architectural SPR handling have it. */
+    return false;
+}
+
+/* --- machine ------------------------------------------------------------- */
+
+/* There is exactly one AX3292 machine per process. */
+static Ax3292State *ax3292_current;
+
+static void ax3292_cpu_reset(void *opaque)
+{
+    OpenRISCCPU *cpu = opaque;
+    CPUState *cs = CPU(cpu);
+    uint32_t entry = ax3292_current ? ax3292_current->entry : AX3292_ENTRY;
+
+    cpu_reset(cs);
+    cpu_set_pc(cs, entry);
+    cpu_set_gpr(&cpu->env, 1, AX3292_STACK_TOP);
+}
+
+static void ax3292_machine_init(MachineState *machine)
+{
+    Ax3292State *s = AX3292_MACHINE(machine);
+    OpenRISCCPU *cpu;
+    const char *env;
+    ssize_t size;
+
+    s->trace = true;
+    s->trace_limit = 300000;
+    s->entry = AX3292_ENTRY;
+    ax3292_current = s;
+    env = getenv("AX3292_ENTRY");
+    if (env != NULL) {
+        s->entry = strtoul(env, NULL, 0);
+    }
+    env = getenv("AX3292_SPR_TRACE");
+    if (env != NULL) {
+        s->trace = atoi(env) != 0;
+    }
+    env = getenv("AX3292_SPR_TRACE_LIMIT");
+    if (env != NULL) {
+        s->trace_limit = strtoul(env, NULL, 0);
+    }
+
+    memory_region_init_ram(&s->ram, NULL, "ax3292.ram",
+                           machine->ram_size, &error_fatal);
+    memory_region_add_subregion(get_system_memory(), 0, &s->ram);
+
+    cpu = OPENRISC_CPU(cpu_create(machine->cpu_type));
+    cpu->env.nodelay = true;        /* the vendor toolchain emits no delay slots */
+    cpu->env.little_endian = true;  /* AX3292 reset SR has LEE set */
+    cpu->env.spr_hook = ax3292_spr_access;
+    cpu->env.spr_hook_opaque = s;
+    qemu_register_reset(ax3292_cpu_reset, cpu);
+
+    if (machine->kernel_filename) {
+        size = load_image_targphys(machine->kernel_filename, AX3292_SDRAM_BASE,
+                                   machine->ram_size - AX3292_SDRAM_BASE, NULL);
+        if (size < 0) {
+            error_report("could not load application '%s'",
+                         machine->kernel_filename);
+            exit(1);
+        }
+        if (s->trace) {
+            fprintf(stderr, "ax3292: loaded %s at %#x (%zd bytes)\n",
+                    machine->kernel_filename, AX3292_SDRAM_BASE, size);
+        }
+    }
+
+    if (s->trace) {
+        fprintf(stderr, "ax3292: entry %#x stack %#x trace limit %lu\n",
+                s->entry, AX3292_STACK_TOP, s->trace_limit);
+    }
+}
+
+static void ax3292_machine_class_init(ObjectClass *oc, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+
+    mc->desc = "AX3292 camera (KC02 family)";
+    mc->init = ax3292_machine_init;
+    mc->max_cpus = 1;
+    mc->default_cpu_type = OPENRISC_CPU_TYPE_NAME("or1200");
+    mc->default_ram_size = AX3292_RAM_SIZE;
+}
+
+static const TypeInfo ax3292_machine_typeinfo = {
+    .name          = TYPE_AX3292_MACHINE,
+    .parent        = TYPE_MACHINE,
+    .class_init    = ax3292_machine_class_init,
+    .instance_size = sizeof(Ax3292State),
+};
+
+static void ax3292_machine_register_types(void)
+{
+    type_register_static(&ax3292_machine_typeinfo);
+}
+
+type_init(ax3292_machine_register_types)
