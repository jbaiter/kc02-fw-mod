+/* Preserve the distinction between SPRs and ordinary RAM through reload.  */
+bool
+or1k_sfr_memory_p (rtx op)
+{
+  if (GET_CODE (op) == SUBREG)
+    op = SUBREG_REG (op);
+  return MEM_P (op) && MEM_ADDR_SPACE (op) == OR1K_ADDR_SPACE_SFR;
+}
+
+/* SPR instructions use an unsigned immediate ORed with a base register.
+   Do not encode register+displacement addresses as if this were addition.  */
+void
+or1k_print_sfr_operand (FILE *stream, rtx op, int code)
+{
+  rtx addr;
+  gcc_assert (or1k_sfr_memory_p (op) && GET_MODE (op) == SImode);
+  addr = XEXP (op, 0);
+  if (REG_P (addr))
+    {
+      if (code == 'A')
+        fputs (reg_names[REGNO (addr)], stream);
+      else
+        fputs ("0", stream);
+    }
+  else
+    {
+      gcc_assert (CONST_INT_P (addr) && IN_RANGE (INTVAL (addr), 0, 65535));
+      if (code == 'A')
+        fputs ("r0", stream);
+      else
+        output_addr_const (stream, addr);
+    }
+}
 
