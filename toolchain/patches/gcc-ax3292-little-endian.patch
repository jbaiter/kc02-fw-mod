+/* The vendor encodes the SDK's numeric SFR address directly as the SPR
+   selector, e.g. SDBAUD == 0x9888.  Pointers retain the ordinary 32-bit size.  */
+static enum machine_mode
+or1k_addr_space_pointer_mode (addr_space_t as ATTRIBUTE_UNUSED)
+{
+  return ptr_mode;
+}
+
+static enum machine_mode
+or1k_addr_space_address_mode (addr_space_t as ATTRIBUTE_UNUSED)
+{
+  return Pmode;
+}
+
+static bool
+or1k_addr_space_legitimate_address_p (enum machine_mode mode, rtx x,
+                                     bool strict, addr_space_t as)
+{
+  if (ADDR_SPACE_GENERIC_P (as))
+    return or1k_legitimate_address_p (mode, x, strict);
+
+  gcc_assert (as == OR1K_ADDR_SPACE_SFR);
+  if (CONST_INT_P (x))
+    {
+      if (!IN_RANGE (INTVAL (x), 0, 65535))
+        error ("constant __sfr selector must be in the range 0..65535");
+      else if (mode == SImode && (INTVAL (x) & 3) != 0)
+        error ("unsupported __sfr access; use an aligned 32-bit integer load/store");
+      return IN_RANGE (INTVAL (x), 0, 65535);
+    }
+  return REG_P (x) && or1k_regnum_ok_for_base_p (REGNO (x), strict);
+}
+
+/* An SPR selector has no byte/halfword interpretation.  Prevent combine
+   from narrowing even nonvolatile 32-bit reads into ordinary byte loads.  */
+static bool
+or1k_mode_dependent_address_p (const_rtx addr ATTRIBUTE_UNUSED, addr_space_t as)
+{
+  return as == OR1K_ADDR_SPACE_SFR;
+}
+
+static rtx
+or1k_addr_space_legitimize_address (rtx x, rtx oldx,
+                                   enum machine_mode mode, addr_space_t as)
+{
+  if (ADDR_SPACE_GENERIC_P (as))
+    return or1k_legitimize_address (x, oldx, mode);
+
+  if (CONST_INT_P (x) && !IN_RANGE (INTVAL (x), 0, 65535))
+    error ("constant __sfr selector must be in the range 0..65535");
+
+  /* GCC will materialize an invalid SPR address expression in a register.
+     In particular, p + n must be computed as addition, not SPR's base OR K.  */
+  return x;
+}
+
+/* Reinterpreting a pointer between disjoint spaces otherwise merely warns
+   in GCC 4.9 and expands to zero.  Require an explicit integer-address cast.  */
+static const char *
+or1k_invalid_conversion (const_tree from, const_tree to)
+{
+  if (POINTER_TYPE_P (from) && POINTER_TYPE_P (to)
+      && TYPE_ADDR_SPACE (TREE_TYPE (from)) != TYPE_ADDR_SPACE (TREE_TYPE (to)))
+    return "cannot convert between __sfr and RAM pointers; cast via an integer address instead";
+  return NULL;
+}
+
+static void
+or1k_insert_attributes (tree decl, tree *attributes ATTRIBUTE_UNUSED)
+{
+  if (TREE_CODE (decl) == VAR_DECL
+      && TYPE_ADDR_SPACE (TREE_TYPE (decl)) == OR1K_ADDR_SPACE_SFR)
+    error ("__sfr objects require numeric SPR pointers, not storage declarations");
+}
