+/* AX3292 SPR map note.  Generic OpenRISC puts the status register at SPR 17.
+   The AX3292 register file is grouped by SPRGROUP_* with
+   MAX_SPRS_PER_GRP_BITS == 11, and the SDK headers (ax329x.h) define
+   SPR_SR = SPRGROUP_SYS + (0x6 << 2) == 0x18 and SPR_VR == 0x0.  Stock
+   firmware reads and writes 0x18 for interrupt critical sections, and its
+   cache routines address the DC/IC groups at 0x1800/0x2000, confirming the
+   map.  SPR 17 is not defined in that map, so the legacy read/write below
+   would touch an unspecified system register.  Keep both sides consistent. */
+#define OR1K_STATUS_SPR 24
+
+#if defined(__OR1K_NODELAY__)
+.nodelay
+#endif
 .align  4
 .global setjmp
 .type   setjmp,@function
@@ -45,8 +58,8 @@
 	l.sw	100(r3), r26
 	l.sw	108(r3), r28
 	l.sw	116(r3), r30
-	/* Save Status Register */
-	l.mfspr	r13, r0, 17
+	/* Save Status Register (AX3292: SPR 0x18) */
+	l.mfspr	r13, r0, OR1K_STATUS_SPR
 	l.sw	124(r3), r13
 /* Set result register to 0 and jump */
 // Different cases for optional delay slot
